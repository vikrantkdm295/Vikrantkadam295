    <style>
        * { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
        ::selection { background: #14B8A6; color: #0A1628; }

        .slide { 
            opacity: 0; 
            transform: translateY(30px); 
            transition: all 0.7s cubic-bezier(0.4, 0, 0.2, 1); 
            pointer-events: none;
            position: absolute;
            inset: 0;
        }
        .slide.active { 
            opacity: 1; 
            transform: translateY(0); 
            pointer-events: auto;
        }
        .slide.exit-up {
            opacity: 0;
            transform: translateY(-30px);
        }

        .stat-card { transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
        .stat-card:hover { transform: translateY(-6px); }

        .pulse-ring {
            animation: pulseRing 2.5s ease-out infinite;
        }
        @keyframes pulseRing {
            0% { transform: scale(1); opacity: 0.6; }
            100% { transform: scale(1.8); opacity: 0; }
        }

        .float { animation: float 6s ease-in-out infinite; }
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
        }

        .heartbeat-line {
            stroke-dasharray: 1000;
            stroke-dashoffset: 1000;
            animation: drawLine 3s ease forwards;
        }
        @keyframes drawLine {
            to { stroke-dashoffset: 0; }
        }

        .gradient-text {
            background: linear-gradient(135deg, #2DD4BF, #06B6D4, #FBBF24);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .slide-indicator { transition: all 0.4s ease; }
        .slide-indicator.active { width: 32px; border-radius: 9999px; }

        .card-glow:hover {
            box-shadow: 0 0 40px rgba(20, 184, 166, 0.15), 0 20px 60px rgba(0,0,0,0.3);
        }

        .country-card { transition: all 0.5s ease; }
        .country-card:hover { transform: scale(1.03); }
        .country-card:hover .country-img { transform: scale(1.08); }
        .country-img { transition: transform 0.7s ease; }

        .trust-icon { transition: all 0.4s ease; }
        .trust-icon:hover { transform: scale(1.1) rotate(5deg); }

        @keyframes countUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .count-anim { animation: countUp 0.6s ease forwards; }

        .bg-grid {
            background-image: 
                linear-gradient(rgba(20,184,166,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(20,184,166,0.03) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        .nav-btn {
            transition: all 0.3s ease;
            backdrop-filter: blur(12px);
        }
        .nav-btn:hover { background: rgba(20, 184, 166, 0.2); border-color: rgba(45, 212, 191, 0.4); }
        .nav-btn:active { transform: scale(0.95); }

        .cta-pulse {
            animation: ctaPulse 2s ease-in-out infinite;
        }
        @keyframes ctaPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(20, 184, 166, 0.4); }
            50% { box-shadow: 0 0 0 12px rgba(20, 184, 166, 0); }
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0A1628; }
        ::-webkit-scrollbar-thumb { background: #1B3A60; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #14B8A6; }

        .slide-content-scroll {
            overflow-y: auto;
            max-height: 100vh;
            scrollbar-width: thin;
            scrollbar-color: #1B3A60 transparent;
        }
    </style>
</head>
<body class="bg-navy-900 text-white font-body overflow-hidden h-screen w-screen relative">

