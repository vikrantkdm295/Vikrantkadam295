                        <div>
                            <div class="text-2xl md:text-3xl font-heading font-800 text-white">92%</div>
                            <div class="text-xs text-zinc-500 uppercase tracking-wider mt-1">NMC Pass Rate</div>
                        </div>
                        <div>
                            <div class="text-2xl md:text-3xl font-heading font-800 text-white">12+</div>
                            <div class="text-xs text-zinc-500 uppercase tracking-wider mt-1">Years Experience</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========== SLIDE 2: THE DREAM ========== -->
