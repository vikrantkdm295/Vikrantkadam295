                <div class="min-h-screen flex items-center px-8 md:px-16 lg:px-24 py-20">
                    <div class="max-w-6xl mx-auto w-full">
                        <!-- Section Label -->
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-8 h-[2px] bg-teal-400"></div>
                            <span class="text-xs uppercase tracking-[0.2em] text-teal-400 font-heading font-600">The Dream</span>
