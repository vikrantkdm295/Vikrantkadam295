                        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
                            <!-- Left Content -->
                            <div>
                                <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl font-800 leading-[1.05] tracking-tight mb-6">
                                    A Global Degree,<br>
